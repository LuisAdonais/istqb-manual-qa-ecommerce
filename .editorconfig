root = true

# ─── All files ────────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# ─── Markdown ─────────────────────────────────────
# trim_trailing_whitespace = false preserves intentional
# two-space line breaks used in Markdown formatting.
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# ─── JSON ─────────────────────────────────────────
[*.json]
indent_size = 2

# ─── YAML ─────────────────────────────────────────
[*.{yml,yaml}]
indent_size = 2
